# Database
DATABASE_URL=postgresql+asyncpg://asa_user:asa_pass@localhost:5432/ai_study_assistant
DATABASE_URL_SYNC=postgresql://asa_user:asa_pass@localhost:5432/ai_study_assistant

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini
GEMINI_API_KEY=your-gemini-api-key
# Optional comma-separated rotation keys; takes precedence over GEMINI_API_KEY
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Chunking
CHUNK_TARGET_TOKENS=350
CHUNK_OVERLAP_TOKENS=60

# Storage
STORAGE_BUCKET=documents

# OCR limits
OCR_LIMIT_PAGES_PER_DOC=50
OCR_LIMIT_PAGES_PER_USER_PER_DAY=100
OCR_FALLBACK_ENABLED=false

# Per-user rate limits (requests per minute; 0 disables)
RATE_LIMIT_UPLOADS_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_PROCESSING_PER_MINUTE=10

# App
ENVIRONMENT=development
DEBUG=false
APP_NAME="AI Study Assistant"
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
